<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Prototype OKLCH converted via OKLab to linear sRGB, gamma encoded and gamut clipped. -->
    <SolidColorBrush x:Key="Bg" Color="#0F0B09"/>
    <SolidColorBrush x:Key="Panel" Color="#191510"/>
    <SolidColorBrush x:Key="Panel2" Color="#221C17"/>
    <SolidColorBrush x:Key="Panel3" Color="#2B251F"/>
    <SolidColorBrush x:Key="Line" Color="#352F29"/>
    <SolidColorBrush x:Key="Line2" Color="#484139"/>
    <SolidColorBrush x:Key="Ink" Color="#EDE7DE"/>
    <SolidColorBrush x:Key="Ink2" Color="#B7B0A6"/>
    <SolidColorBrush x:Key="Ink3" Color="#807970"/>
    <SolidColorBrush x:Key="Seal" Color="#DF6A55"/>
    <SolidColorBrush x:Key="Gold" Color="#C48400"/>
    <SolidColorBrush x:Key="GoldBg" Color="#21C48400"/>
    <SolidColorBrush x:Key="SealBg" Color="#24DF6A55"/>
    <SolidColorBrush x:Key="Connected" Color="#5BBD74"/>
    <!-- Sans / Serif 随界面语言替换（MainWindow.ApplyLanguage），引用处一律用 DynamicResource -->
    <FontFamily x:Key="Sans">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Serif">Noto Serif SC, SimSun, Source Han Serif SC</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <DrawingBrush x:Key="Hatch" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Panel}" Geometry="M0,0 H12 V12 H0 Z"/>
                <GeometryDrawing Brush="{StaticResource Panel2}" Geometry="M0,0 H6 L0,6 Z M12,0 V6 L6,12 H0 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="DangerHatch" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource SealBg}" Geometry="M0,0 H6 V6 H0 Z"/>
                <GeometryDrawing Brush="#52DF6A55" Geometry="M0,0 H3 L0,3 Z M6,0 V3 L3,6 H0 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{DynamicResource Serif}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
        <Setter Property="Background" Value="{StaticResource Panel2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}"/>
                            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Seal}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Seal}"/>
        <Setter Property="Foreground" Value="{StaticResource Bg}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Serif}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="22,7"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Gold}"/>
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="2">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Seal}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="NumericInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#090706"/>
                <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FieldCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                <Setter Property="Background" Value="{StaticResource GoldBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StepperButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="10">
                        <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource Ink3}" HorizontalAlignment="Left" Margin="2,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Seal}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Bg}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Gold}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Frame" Background="Transparent" Padding="7,4" CornerRadius="2">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource Panel3}"/>
                            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Thumb" x:Key="ScrollThumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource Panel3}" CornerRadius="4" Margin="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="TickFrequency" Value="1"/>
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="18">
                        <Border Height="8" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line2}" BorderThickness="1"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" Background="{StaticResource Ink2}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="8" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource Ink}" BorderBrush="{StaticResource Bg}" BorderThickness="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 悬停提示：默认是白底，配我们的浅色字看不清，统一成深色面板 -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- 标题栏语言选择：按钮显示当前语言，点开弹出列表 -->
    <Style x:Key="LanguageButton" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Box" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="10,5" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center"/>
                            <TextBlock Text="▾" Margin="6,0,0,0" Foreground="{StaticResource Ink3}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Line2}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Seal}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LanguageItem" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Row" Background="Transparent" Padding="12,7">
                        <ContentPresenter HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Panel2}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
