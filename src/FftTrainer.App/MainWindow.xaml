                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{local:Loc ui.battle.continuous}" Style="{StaticResource Muted}"/>
                                                <TextBlock Text="{local:Loc ui.battle.instantCast.title}" Foreground="{StaticResource Ink2}"/>
                                            </DockPanel>
                                            <TextBlock Text="{local:Loc ui.battle.instantCast.desc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                            <ToggleButton IsEnabled="{Binding CanSetBattleOptions}" IsChecked="{Binding InstantCast, Mode=TwoWay}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock DockPanel.Dock="Left" Text="◆" Foreground="{StaticResource Seal}" FontSize="10" Margin="0,0,10,0"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{local:Loc ui.battle.section.multipliers}" Style="{StaticResource Section}" Margin="0,0,12,0"/>
                                        <Border Height="1" Background="{StaticResource Line}"/>
                                    </DockPanel>
                                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,12" MinHeight="94">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{local:Loc ui.battle.unsupported}" Style="{StaticResource Muted}"/>
                                                <TextBlock Text="{local:Loc ui.battle.damage.title}" Foreground="{StaticResource Ink2}"/>
                                            </DockPanel>
                                            <TextBlock Text="{local:Loc ui.battle.damage.desc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                            <Border HorizontalAlignment="Right" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="3" Padding="2">
                                                <StackPanel Orientation="Horizontal" IsEnabled="False">
                                                    <RadioButton Content="1×" GroupName="Multiplier0" IsChecked="True" Style="{StaticResource Segment}"/>
                                                    <RadioButton Content="2×" GroupName="Multiplier0" IsChecked="False" Style="{StaticResource Segment}"/>
                                                    <RadioButton Content="5×" GroupName="Multiplier0" IsChecked="False" Style="{StaticResource Segment}"/>
                                                    <RadioButton Content="{local:Loc ui.battle.damage.oneHit}" GroupName="Multiplier0" IsChecked="False" Style="{StaticResource Segment}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,12" MinHeight="94">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{local:Loc ui.battle.exp.title}" Foreground="{StaticResource Ink2}"/>
                                            </DockPanel>
                                            <TextBlock Text="{local:Loc ui.battle.exp.desc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                            <Border HorizontalAlignment="Right" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="3" Padding="2">
                                                <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanSetBattleOptions}">
                                                    <RadioButton Content="1×" IsChecked="{Binding ExperienceMultiplier, Mode=TwoWay, Converter={StaticResource MultiplierValue}, ConverterParameter=1}" Style="{StaticResource Segment}"/>
                                                    <RadioButton Content="2×" IsChecked="{Binding ExperienceMultiplier, Mode=TwoWay, Converter={StaticResource MultiplierValue}, ConverterParameter=2}" Style="{StaticResource Segment}"/>
                                                    <RadioButton Content="5×" IsChecked="{Binding ExperienceMultiplier, Mode=TwoWay, Converter={StaticResource MultiplierValue}, ConverterParameter=5}" Style="{StaticResource Segment}"/>
                                                    <RadioButton Content="10×" IsChecked="{Binding ExperienceMultiplier, Mode=TwoWay, Converter={StaticResource MultiplierValue}, ConverterParameter=10}" Style="{StaticResource Segment}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,12" MinHeight="94">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{local:Loc ui.battle.jp.title}" Foreground="{StaticResource Ink2}"/>
                                            </DockPanel>
                                            <TextBlock Text="{local:Loc ui.battle.jp.desc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                            <Border HorizontalAlignment="Right" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="3" Padding="2">
                                                <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanSetBattleOptions}">
                                                    <RadioButton Content="1×" IsChecked="{Binding JpMultiplier, Mode=TwoWay, Converter={StaticResource MultiplierValue}, ConverterParameter=1}" Style="{StaticResource Segment}"/>
                                                    <RadioButton Content="2×" IsChecked="{Binding JpMultiplier, Mode=TwoWay, Converter={StaticResource MultiplierValue}, ConverterParameter=2}" Style="{StaticResource Segment}"/>
                                                    <RadioButton Content="5×" IsChecked="{Binding JpMultiplier, Mode=TwoWay, Converter={StaticResource MultiplierValue}, ConverterParameter=5}" Style="{StaticResource Segment}"/>
                                                    <RadioButton Content="10×" IsChecked="{Binding JpMultiplier, Mode=TwoWay, Converter={StaticResource MultiplierValue}, ConverterParameter=10}" Style="{StaticResource Segment}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,12" MinHeight="94">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{local:Loc ui.battle.unsupported}" Style="{StaticResource Muted}"/>
                                                <TextBlock Text="{local:Loc ui.battle.sureHit.title}" Foreground="{StaticResource Ink2}"/>
                                            </DockPanel>
                                            <TextBlock Text="{local:Loc ui.battle.sureHit.desc}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                            <ToggleButton IsEnabled="False" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Grid IsEnabled="{Binding InBattle}" Margin="0,26,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{local:Loc ui.battle.side.party}" Style="{StaticResource Section}" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding Allies}" ItemTemplate="{StaticResource BattleCard}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{local:Loc ui.battle.side.guests}" Style="{StaticResource Section}" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding Guests}" ItemTemplate="{StaticResource BattleCard}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{local:Loc ui.battle.side.enemies}" Style="{StaticResource Section}" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding Enemies}" ItemTemplate="{StaticResource BattleCard}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Margin="28,24">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tab}" Value="2">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16">
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="{local:Loc ui.items.maxVisible}" Command="{Binding MaxVisibleItems}"/>
                                <TextBlock Text="{local:Loc ui.items.hint}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <WrapPanel>
                                <TextBlock Text="{local:Loc ui.items.search}" Style="{StaticResource Muted}" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding ItemSearch, UpdateSourceTrigger=PropertyChanged}" Width="220" FontFamily="{DynamicResource Sans}" Padding="12,8" Margin="0,0,16,0" ToolTip="{local:Loc ui.items.searchTip}"/>
                                <CheckBox Foreground="{StaticResource Ink2}" Content="{local:Loc ui.items.showAll}" IsChecked="{Binding ShowAllItems}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <RadioButton Content="{local:Loc ui.items.cat.all}" GroupName="ItemCategory" Command="{Binding ShowAllCategories}" Style="{StaticResource Segment}" Margin="0,0,8,0" IsChecked="True"/>
                                <RadioButton Content="{local:Loc ui.items.cat.consumables}" GroupName="ItemCategory" Command="{Binding ShowConsumables}" Style="{StaticResource Segment}" Margin="0,0,8,0"/>
                                <RadioButton Content="{local:Loc ui.items.cat.equipment}" GroupName="ItemCategory" Command="{Binding ShowEquipment}" Style="{StaticResource Segment}" Margin="0,0,8,0"/>
                                <RadioButton Content="{local:Loc ui.items.cat.bonus}" GroupName="ItemCategory" Command="{Binding ShowBonusItems}" Style="{StaticResource Segment}" Margin="0,0,8,0"/>
                                <RadioButton Content="{local:Loc ui.items.cat.poaching}" GroupName="ItemCategory" Command="{Binding ShowPoaching}" Style="{StaticResource Segment}" Margin="0,0,8,0"/>
                                <TextBlock Text="{local:Loc ui.items.poachingNote}" FontSize="10" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </StackPanel>
                        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:Loc ui.items.col.item}" Style="{StaticResource Muted}"/>
                                <TextBlock Grid.Column="1" Text="{local:Loc ui.items.col.category}" Style="{StaticResource Muted}"/>
                                <TextBlock Grid.Column="2" Text="ID" Style="{StaticResource Muted}"/>
                                <TextBlock Grid.Column="3" Text="{local:Loc ui.items.col.quantity}" Style="{StaticResource Muted}"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding VisibleItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,1,1" Padding="16,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Category}" Style="{StaticResource Muted}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding HexId}" Style="{StaticResource Muted}" FontFamily="{StaticResource Mono}"/>
                                                <ContentControl Grid.Column="3" Content="{Binding Quantity}" ContentTemplate="{StaticResource Stepper}" HorizontalAlignment="Left"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
                <Border Background="{StaticResource Bg}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="◇" Foreground="{StaticResource Seal}" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="{local:Loc ui.waiting.title}" FontFamily="{DynamicResource Serif}" FontSize="22"/>
                        <TextBlock Text="{local:Loc ui.waiting.desc}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,10,18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Pending.Count}" Foreground="{StaticResource Gold}" FontFamily="{StaticResource Mono}"/>
                            <TextBlock Text="{local:Loc ui.footer.pending}" FontFamily="{DynamicResource Serif}"/>
                        </StackPanel>
                        <Button Content="{Binding BackupText}" ToolTip="{local:Loc ui.footer.openBackups}" Click="OpenSaveBackups" FontSize="10" Padding="5,3" Margin="0,5,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="2" Text="{local:Loc ui.footer.jpHint}" TextWrapping="Wrap" Foreground="{StaticResource Gold}" FontSize="11" Margin="0,5,0,0" Visibility="{Binding HasJpChanges, Converter={StaticResource BoolVisibility}}"/>
                        <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" Style="{StaticResource Muted}"/>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding HasChanges, Converter={StaticResource BoolVisibility}}">
                            <ItemsControl ItemsSource="{Binding Pending}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="9,4" Margin="0,0,8,0" CornerRadius="3" ToolTip="{Binding Error}" Background="{StaticResource Bg}" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource Seal}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Seal}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding ChangeText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <Button Grid.Column="2" Content="{local:Loc ui.footer.undoAll}" Command="{Binding Undo}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Click="WriteChanges" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanEdit}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasChanges}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{local:Loc ui.footer.write}" Foreground="{StaticResource Bg}"/>
                            <TextBlock Text="Ctrl+S" FontSize="10" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Panel3}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <Border x:Name="SkillPicker" Grid.RowSpan="4" Panel.ZIndex="20" Background="#C00F0B09" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
                <Border Width="500" MaxHeight="580" Margin="24" Padding="24" VerticalAlignment="Center" Background="{StaticResource Panel}" BorderBrush="{StaticResource Gold}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontFamily="{DynamicResource Serif}" FontSize="22">
                            <Run Text="{local:Loc ui.picker.titlePrefix}"/><Run Text="{Binding Name, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Grid.Row="1" Text="{local:Loc ui.picker.hint}" Foreground="{StaticResource Ink3}" Margin="0,10,0,16"/>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Candidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="ChooseSkill" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="12,10">
                                            <Grid Width="390">
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Text="{Binding IdText}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button x:Name="CloseSkillPickerButton" Grid.Row="3" Content="{local:Loc ui.picker.cancel}" Click="CloseSkillPicker" HorizontalAlignment="Right" Margin="0,16,0,0"/>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
