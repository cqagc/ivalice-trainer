<Window xmlns:local="clr-namespace:FftTrainer.App" xmlns:core="clr-namespace:FftTrainer.Core;assembly=FftTrainer.Core" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="FftTrainer.App.MainWindow" Title="{local:Loc app.name}" Icon="Assets/app.ico" Width="1320" Height="860" MinWidth="1100" MinHeight="700" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" FontFamily="{DynamicResource Sans}" FontSize="13" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <local:PortraitConverter x:Key="PortraitImage"/>
        <local:MultiplierConverter x:Key="MultiplierValue"/>
        <DataTemplate x:Key="Stepper">
            <Border BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="3" Background="{StaticResource Bg}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="−" Command="{Binding Decrease}" Style="{StaticResource StepperButton}"/>
                    <TextBox Style="{StaticResource NumericInput}" Width="52" Height="26" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="+" Command="{Binding Increase}" Style="{StaticResource StepperButton}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="BattleNumberField">
            <TextBox Style="{StaticResource NumericInput}" Width="44" FontSize="11" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Label}"/>
        </DataTemplate>
        <Style x:Key="BattleBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Background" Value="{StaticResource Bg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="BattleCard">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,10" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="54"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" FontSize="10" Foreground="{StaticResource Ink2}">
                                <Run Text="{Binding Level, Mode=OneWay}"/>
                                <Run Text=" │ "/>
                                <Run Text="{Binding Experience, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Serif}" FontSize="18" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{local:Loc ui.card.hp}" FontSize="11" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <ContentControl Content="{Binding Hp}" ContentTemplate="{StaticResource BattleNumberField}" IsEnabled="{Binding CanChangeHp}"/>
                                    <TextBlock FontSize="11"><Run Text="/"/><Run Text="{Binding MaxHp, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                                <ProgressBar Maximum="{Binding MaxHp}" Foreground="#62863C">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource BattleBar}">
                                            <Setter Property="Value" Value="{Binding Hp.Value, Mode=OneWay}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanChangeHp}" Value="False">
                                                    <Setter Property="Value" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{local:Loc ui.card.mp}" FontSize="11" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <ContentControl Content="{Binding Mp}" ContentTemplate="{StaticResource BattleNumberField}"/>
                                    <TextBlock FontSize="11"><Run Text="/"/><Run Text="{Binding MaxMp, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                                <ProgressBar Maximum="{Binding MaxMp}" Value="{Binding Mp.Value, Mode=OneWay}" Style="{StaticResource BattleBar}">
                                    <ProgressBar.Foreground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#A95243" Offset="0"/>
                                            <GradientStop Color="#BD8C52" Offset="1"/>
                                        </LinearGradientBrush>
                                    </ProgressBar.Foreground>
                                </ProgressBar>
                            </StackPanel>
                        </Grid>
                        <Grid ToolTip="{Binding CtTip}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,5">
                                <TextBlock DockPanel.Dock="Left" Text="{local:Loc ui.card.ct}" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CtLabel, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center"/>
                                <ContentControl DockPanel.Dock="Right" Content="{Binding Ct}" ContentTemplate="{StaticResource BattleNumberField}"/>
                                <ProgressBar Value="{Binding Ct.Value, Mode=OneWay}" Maximum="100" Style="{StaticResource BattleBar}" Foreground="{StaticResource Gold}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Grid.Row="1" HorizontalAlignment="Left" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="2,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Loc ui.card.brave}" FontSize="9" Foreground="{StaticResource Ink2}"/>
                                    <ContentControl Content="{Binding Brave}" ContentTemplate="{StaticResource BattleNumberField}"/>
                                    <TextBlock Text="{local:Loc ui.card.faith}" FontSize="9" Foreground="{StaticResource Ink2}" Margin="2,0,0,0"/>
                                    <ContentControl Content="{Binding Faith}" ContentTemplate="{StaticResource BattleNumberField}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DockPanel Margin="0,4,0,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{StaticResource Seal}" FontSize="10"/>
                        </DockPanel>
                        <Border Background="{StaticResource Bg}" Padding="4,4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding JobProgressText}" FontSize="10" Foreground="{StaticResource Ink2}"/>
                                <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Job}">
                                    <Run Text="▪ "/><Run Text="{Binding Job, Mode=OneWay}"/>
                                </TextBlock>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource Hatch}" BorderBrush="{StaticResource Line2}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Portrait, Converter={StaticResource PortraitImage}}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FactionLabel}" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{StaticResource Seal}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FactionLabel}" Value="TARGET">
                                                <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FactionLabel}" Value="GUEST">
                                                <Setter Property="Foreground" Value="#6C9FC8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Serif}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Underline" Padding="18,0" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                <Setter TargetName="Underline" Property="BorderBrush" Value="{StaticResource Seal}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto" MinHeight="64"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" Background="{StaticResource Seal}" CornerRadius="2" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-4"/>
                            </Border.RenderTransform>
                            <TextBlock Text="伊" Foreground="{StaticResource Bg}" FontFamily="{DynamicResource Serif}" FontSize="15" FontWeight="Black" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{local:Loc app.name}" FontFamily="{DynamicResource Serif}" FontWeight="Bold" FontSize="15" Margin="0"/>
                            <TextBlock Text="FFT · IVALICE CHRONICLES" Style="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="9"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton Content="{local:Loc ui.nav.roster}" Tag="0" IsChecked="True" Checked="OnTabChanged" Style="{StaticResource NavTab}"/>
                        <RadioButton Content="{local:Loc ui.nav.battle}" Tag="1" Checked="OnTabChanged" Style="{StaticResource NavTab}"/>
                        <RadioButton Content="{local:Loc ui.nav.items}" Tag="2" Checked="OnTabChanged" Style="{StaticResource NavTab}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="10,5" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Ink3}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Connected}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ConnectionText}" FontSize="11" Foreground="{StaticResource Ink2}" FontFamily="{StaticResource Mono}"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,0,12,0">
                            <ToggleButton x:Name="LanguageButton" Style="{StaticResource LanguageButton}" ToolTip="{local:Loc app.language}"
                                          Content="{Binding Language.NativeName, Source={x:Static core:Localizer.Instance}}"/>
                            <Popup IsOpen="{Binding IsChecked, ElementName=LanguageButton}" PlacementTarget="{Binding ElementName=LanguageButton}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Closed="OnLanguagePopupClosed">
                                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line2}" BorderThickness="1" Padding="4" Margin="0,4,0,0">
                                    <ItemsControl x:Name="LanguageList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding NativeName}" Tag="{Binding}" Click="OnLanguageSelected" Style="{StaticResource LanguageItem}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button Content="─" Width="36" Height="30" Padding="0" BorderThickness="0" Background="Transparent" Click="MinimizeWindow" ToolTip="{local:Loc ui.window.minimize}"/>
                        <Button Content="□" Width="36" Height="30" Padding="0" BorderThickness="0" Background="Transparent" Click="MaximizeWindow" ToolTip="{local:Loc ui.window.maximize}"/>
                        <Button Content="×" Width="36" Height="30" Padding="0" BorderThickness="0" Background="Transparent" Click="CloseWindow" ToolTip="{local:Loc ui.window.close}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#191510" Offset="0"/>
                        <GradientStop Color="#0F0B09" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEdit}">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="22,10">
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Gil}">
                            <TextBlock Text="{local:Loc ui.header.gil}" Style="{StaticResource Muted}" FontFamily="{DynamicResource Serif}" Margin="0,0,14,0"/>
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="150" TextAlignment="Right" FontSize="22" Foreground="{StaticResource Gold}" Background="Transparent" BorderThickness="0,0,0,1"/>
                            <Button Content="{local:Loc ui.header.maxGil}" Command="{Binding Maximize}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="22,0">
                        <TextBlock Text="{Binding RosterCountText}" FontFamily="{StaticResource Mono}" FontSize="14"/>
                        <TextBlock Text="{local:Loc ui.header.unitCount}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2">
                <Grid Visibility="{Binding IsConnected, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanEdit}">
                    <Grid x:Name="RosterPage">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tab}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="268"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="18,16,18,10">
                                    <TextBlock Text="{local:Loc ui.roster.title}" Style="{StaticResource Section}"/>
                                    <TextBlock Text="{local:LocFormat ui.roster.count, Path=Units.Count}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ListBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="16,10">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Panel3}"/>
                                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Seal}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Panel2}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" Background="{StaticResource Hatch}" BorderBrush="{StaticResource Line2}" BorderThickness="1" HorizontalAlignment="Left">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initial}" FontFamily="{DynamicResource Serif}" FontSize="15" HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Source, ElementName=RosterFace}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image x:Name="RosterFace" Source="{Binding Portrait, Converter={StaticResource PortraitImage}, ConverterParameter=thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Serif}" FontSize="14"/>
                                                        <TextBlock Text="{local:Loc ui.roster.protagonist}" Foreground="{StaticResource Gold}" FontSize="10" Margin="8,0,0,0" Visibility="{Binding IsProtagonist, Converter={StaticResource BoolVisibility}}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Job}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Ellipse Fill="{StaticResource Gold}" Width="6" Height="6" Margin="0,0,8,0" Visibility="{Binding IsDirty, Converter={StaticResource BoolVisibility}}"/>
                                                    <TextBlock Text="{local:LocFormat ui.roster.level, Path=Level.Value}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Ink2}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,24,28,28" DataContext="{Binding SelectedUnit}">
                                <Grid Height="260" Margin="0,0,0,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="1" Height="260" ClipToBounds="True" IsHitTestVisible="False">
                                        <Grid.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="Transparent" Offset="0"/>
                                                <GradientStop Color="#B3000000" Offset="0.4"/>
                                                <GradientStop Color="Black" Offset="0.8"/>
                                            </LinearGradientBrush>
                                        </Grid.OpacityMask>
                                        <Image Height="520" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.45" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Portrait, Converter={StaticResource PortraitImage}, ConverterParameter=job}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="132"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Height="164" VerticalAlignment="Center" Background="{StaticResource Hatch}" BorderBrush="{StaticResource Line2}" BorderThickness="1">
                                            <Border Margin="4" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="{local:Loc ui.profile.noPortrait}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Source, ElementName=ProfileFace}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image x:Name="ProfileFace" Source="{Binding Portrait, Converter={StaticResource PortraitImage}, ConverterParameter=face}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                </Grid>
                                            </Border>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,12,0">
                                            <TextBlock Text="{Binding Number}" Foreground="{StaticResource Seal}" FontSize="11" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Serif}" FontWeight="Black" FontSize="36" Margin="0,6,0,12"/>
                                            <TextBlock FontFamily="{DynamicResource Serif}" FontSize="16" TextWrapping="Wrap">
                                                <Run Text="{local:Loc ui.profile.job}"/>
                                                <Run Text="{Binding Job, Mode=OneWay}"/>
                                                <Run Text="{local:Loc ui.profile.gender}"/>
                                                <Run Text="{Binding Gender, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{local:Loc ui.profile.zodiacPending}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <TextBlock DockPanel.Dock="Left" Text="◆" Foreground="{StaticResource Seal}" FontSize="10" Margin="0,0,10,0"/>
                                            <TextBlock DockPanel.Dock="Left" Text="{local:Loc ui.stats.title}" Style="{StaticResource Section}" Margin="0,0,12,0"/>
                                            <Border Height="1" Background="{StaticResource Line}"/>
                                        </DockPanel>
                                        <Border Style="{StaticResource FieldCard}" Padding="10,9">
                                            <StackPanel>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level.IsDirty}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{local:Loc ui.stats.level}"/>
                                                    <Run Text="{Binding Level.Value, Mode=OneWay}"/>
                                                </TextBlock>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button Content="{local:Loc ui.stats.gain1}" Command="{Binding Gain1}" Padding="8,4" Margin="0,0,6,0"/>
                                                    <Button Content="{local:Loc ui.stats.gain5}" Command="{Binding Gain5}" Padding="8,4" Margin="0,0,6,0"/>
                                                    <Button Content="{local:Loc ui.stats.gain99}" Command="{Binding Gain99}" Padding="8,4"/>
                                                </WrapPanel>
                                                <TextBlock Text="{local:Loc ui.stats.growthHint}" Style="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource FieldCard}" Padding="10,9" DataContext="{Binding Experience}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{local:Loc ui.stats.exp}" Foreground="{StaticResource Ink2}" FontSize="12"/>
                                                    <TextBlock Text="EXP" Style="{StaticResource Muted}" FontSize="9"/>
                                                </StackPanel>
                                                <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource Stepper}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding DisplayStats}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource FieldCard}" Padding="10,9">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBox DockPanel.Dock="Right" Width="52" Height="26" TextAlignment="Center"
                                                                         IsEnabled="{Binding Available}" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                                                         AutomationProperties.Name="{Binding Name}">
                                                                    <TextBox.Style>
